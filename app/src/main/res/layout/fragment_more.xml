<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Síťové nástroje -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Tools"
            android:textSize="@dimen/text_small"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_port_scanner"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/port_scanner_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bgp_whois"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/bgp_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_speedtest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/speedtest_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <!-- Správa infrastruktury -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Infrastructure"
            android:textSize="@dimen/text_small"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_routeros"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/routeros_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_terminal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/terminal_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_monitoring"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/monitoring_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <!-- Fáze 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced"
            android:textSize="@dimen/text_small"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ssh"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:text="@string/ssh_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snmp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/snmp_title"
            android:gravity="start|center_vertical"
            android:paddingStart="@dimen/spacing_md" />

        <!-- Nastavení -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:text="@string/settings_dark_mode" />

    </LinearLayout>
</ScrollView>
