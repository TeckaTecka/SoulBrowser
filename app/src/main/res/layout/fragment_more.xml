<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- ── Network Tools ──────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/more_section_network" />

                <!-- Port Scanner -->
                <LinearLayout android:id="@+id/btn_port_scanner"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_port"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_port" />
                    <TextView android:id="@+id/title_port"
                        style="@style/MoreRowTitle"
                        android:text="@string/port_scanner_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <!-- BGP / WHOIS -->
                <LinearLayout android:id="@+id/btn_bgp_whois"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_bgp"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_bgp" />
                    <TextView android:id="@+id/title_bgp"
                        style="@style/MoreRowTitle"
                        android:text="@string/bgp_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <!-- Speed Test -->
                <LinearLayout android:id="@+id/btn_speedtest"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_speed"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_speedtest" />
                    <TextView android:id="@+id/title_speed"
                        style="@style/MoreRowTitle"
                        android:text="@string/speedtest_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Infrastructure ────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/more_section_infra" />

                <!-- RouterOS -->
                <LinearLayout android:id="@+id/btn_routeros"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_ros"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_routeros" />
                    <TextView android:id="@+id/title_ros"
                        style="@style/MoreRowTitle"
                        android:text="@string/routeros_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <!-- Terminal Server -->
                <LinearLayout android:id="@+id/btn_terminal"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_term"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_terminal" />
                    <TextView android:id="@+id/title_term"
                        style="@style/MoreRowTitle"
                        android:text="@string/terminal_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <!-- Monitoring -->
                <LinearLayout android:id="@+id/btn_monitoring"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_mon"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_monitoring" />
                    <TextView android:id="@+id/title_mon"
                        style="@style/MoreRowTitle"
                        android:text="@string/monitoring_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Advanced ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/more_section_advanced" />

                <!-- SSH Terminal -->
                <LinearLayout android:id="@+id/btn_ssh"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_ssh"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_ssh" />
                    <TextView android:id="@+id/title_ssh"
                        style="@style/MoreRowTitle"
                        android:text="@string/ssh_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <!-- SNMP Browser -->
                <LinearLayout android:id="@+id/btn_snmp"
                    style="@style/MoreRow">
                    <ImageView android:id="@+id/icon_snmp"
                        style="@style/MoreRowIcon"
                        android:src="@drawable/ic_tool_snmp" />
                    <TextView android:id="@+id/title_snmp"
                        style="@style/MoreRowTitle"
                        android:text="@string/snmp_title" />
                    <ImageView style="@style/MoreRowChevron" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Settings ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionHeader"
                    android:text="@string/settings_section" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="@string/settings_dark_mode"
                    android:textSize="15sp"
                    android:textColor="@color/on_surface" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
