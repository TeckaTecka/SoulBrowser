    <string name="accessibility_service_label">BT Hotspot Auto</string>
    <string name="accessibility_service_description">
        Umožňuje aplikaci automaticky zapnout nebo vypnout WiFi hotspot kliknutím na dlaždici
        v Rychlém nastavení při připojení/odpojení vybraného Bluetooth zařízení.
        Služba se aktivuje pouze při změně stavu Bluetooth.
    </string>

